POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=copytrading
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
N8N_USER=CHANGE_ME
N8N_PASSWORD=CHANGE_ME
# Optional explicit URL (Alembic/tests). If unset, built from POSTGRES_*.
# On the host, migrations/env.py maps POSTGRES_HOST=postgres → localhost.
# DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/copytrading
#
# Pytest isolation (P7-001): dedicated DB `{POSTGRES_DB}_test`, recreated each
# session; critical fixtures TRUNCATE/reseed between tests.
# TEST_DATABASE_NAME=copytrading_test
# TEST_DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/copytrading_test
#
# Live paper DB is forbidden by default. Operator-only double confirmation:
#   PYTEST_USE_LIVE_DB=1
#   PYTEST_ALLOW_LIVE_DB=1
# Always refused when CI=1 or PHASE7_VERIFY=1. Never use for Phase 7 verification.
# PYTEST_USE_LIVE_DB=0
# PYTEST_ALLOW_LIVE_DB=0
#
# Market mark freshness (P7-002/003). Default 30s; read by price_feed.max_mark_age_sec().
# MAX_MARK_AGE_SEC=30
#
# --- Phase 8: exchange adapter (testnet) ---
# Credentials are read from the environment only and are never logged or stored.
# Leave unset to keep the system paper-only: no Bybit adapter can be constructed.
# BYBIT_API_KEY=CHANGE_ME
# BYBIT_API_SECRET=CHANGE_ME
# BYBIT_TESTNET=1
# Mainnet is refused unless this is set. Not an authorized phase.
# BYBIT_ALLOW_MAINNET=0
#
# --- Phase 8A: Paper Exchange Adapter (simulated venue; never sends real orders) ---
# EXCHANGE_ADAPTER=paper
# PAPER_MODE=true
# PAPER_FEES_ENABLED=false
# PAPER_SLIPPAGE_BPS=0
# PAPER_FAILURE_MODE=success
# PAPER_PARTIAL_FILL_RATIO=0.5
# Opt-in only (not part of default CI):
# PAPER_LIVE_MARK=1
# PAPER_SOAK=1
#
# Execution engine tuning (execution_engine.py):
#   margin is reserved at the venue fill price, so the pre-trade affordability
#   check adds this head-room over the signal-price estimate.
# EXECUTION_MARGIN_BUFFER_PCT=0.01
#   how hard to chase an ambiguous order state before arming the kill switch
# EXECUTION_RESOLVE_ATTEMPTS=5
# EXECUTION_RESOLVE_BACKOFF_SEC=0.5
#   consecutive "order not found" reads required to declare an order never sent
# EXECUTION_NOT_FOUND_CONFIRMATIONS=2
